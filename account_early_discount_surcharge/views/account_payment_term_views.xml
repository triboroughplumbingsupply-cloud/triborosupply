<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_inherit_surcharge" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.early.discount.surcharge</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <!-- Discount deadline: days vs day of next month -->
            <xpath expr="//span[contains(text(), '% if paid within')]" position="replace">
                <span invisible="not early_discount"> % if paid </span>
                <field name="discount_deadline_type" class="oe_inline" style="min-width: 200px" invisible="not early_discount"/>
                <span invisible="not early_discount or discount_deadline_type != 'days'"> within </span>
                <span invisible="not early_discount or discount_deadline_type != 'day_of_next_month'"> on or before day </span>
                <field name="discount_day_of_next_month" class="text-end o_field_highlight o_input oe_inline"
                       invisible="not early_discount or discount_deadline_type != 'day_of_next_month'"/>
            </xpath>
            <field name="discount_days" position="attributes">
                <attribute name="invisible">not early_discount or discount_deadline_type != 'days'</attribute>
            </field>
            <xpath expr="//span[normalize-space(text()) = 'days']" position="attributes">
                <attribute name="invisible">not early_discount or discount_deadline_type != 'days'</attribute>
            </xpath>
            <!-- Late surcharge -->
            <xpath expr="//div[hasclass('o_field_highlight')][1]" position="after">
                <label for="late_surcharge"/>
                <div class="o_field_highlight" name="late_surcharge_box">
                    <field name="late_surcharge"/>
                    <field name="late_surcharge_percentage"
                           class="text-end o_field_highlight o_input oe_inline"
                           invisible="not late_surcharge"/>
                    <span invisible="not late_surcharge"> % of the balance unpaid after the due date</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
