<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_surcharge" model="ir.ui.view">
        <field name="name">account.move.form.inherit.early.discount.surcharge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_invoice_sent'][1]" position="before">
                <button name="action_apply_late_surcharge" type="object"
                        string="Apply Late Surcharge" class="btn-secondary"
                        invisible="not late_surcharge_due"
                        groups="account.group_account_invoice"
                        confirm="This will apply the late payment surcharge on the unpaid balance. Continue?"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_late_surcharge_move" type="object" class="oe_stat_button" icon="fa-exclamation-circle"
                        invisible="not late_surcharge_move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Late</span>
                        <span class="o_stat_text">Surcharge</span>
                    </div>
                </button>
                <button name="action_open_late_surcharge_move" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not late_surcharge_origin_move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Original</span>
                        <span class="o_stat_text">Invoice</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//page[@id='other_tab']" position="inside">
                <group name="early_discount_surcharge" string="Early Discount / Late Surcharge"
                       invisible="move_type != 'out_invoice' or (not early_discount_deadline and not late_surcharge_applicable)">
                    <field name="early_discount_deadline" invisible="not early_discount_deadline"/>
                    <field name="early_discount_amount_due" invisible="not early_discount_deadline or late_surcharge_date"/>
                    <field name="late_surcharge_applicable" invisible="1"/>
                    <field name="late_surcharge_due" invisible="1"/>
                    <field name="late_surcharge_percentage" invisible="not late_surcharge_applicable"/>
                    <field name="late_surcharge_amount" invisible="not late_surcharge_applicable or late_surcharge_date or late_surcharge_move_id"/>
                    <field name="late_surcharge_date" invisible="not late_surcharge_date"/>
                    <field name="late_surcharge_applied_amount" invisible="not late_surcharge_date"/>
                    <field name="late_surcharge_move_id" invisible="not late_surcharge_move_id"/>
                    <field name="late_surcharge_origin_move_id" invisible="not late_surcharge_origin_move_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_inherit_surcharge" model="ir.ui.view">
        <field name="name">account.move.list.inherit.early.discount.surcharge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="before">
                <field name="late_surcharge_due" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_inherit_surcharge" model="ir.ui.view">
        <field name="name">account.move.search.inherit.early.discount.surcharge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="late" position="after">
                <filter name="late_surcharge_terms" string="Surcharge Terms" domain="[('late_surcharge_applicable', '=', True)]"/>
                <filter name="has_late_surcharge" string="Surcharge Applied" domain="['|', ('late_surcharge_date', '!=', False), ('late_surcharge_move_id', '!=', False)]"/>
            </filter>
        </field>
    </record>
</odoo>
